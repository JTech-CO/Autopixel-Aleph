{
  "manifest_version": 3,
  "name": "AutoPixel-ℵ",
  "version": "2.2.0",
  "description": "Select rectangles, ellipses or freehand areas, compare template pixels, and paint Wplace or Youplace.",
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    },
    "default_title": "AutoPixel-ℵ"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wplace.live/*",
        "https://*.wplace.live/*",
        "https://youplace.live/*",
        "https://*.youplace.live/*"
      ],
      "js": [
        "src/canvas-bridge.js",
        "src/native-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://wplace.live/*",
        "https://*.wplace.live/*",
        "https://youplace.live/*",
        "https://*.youplace.live/*"
      ],
      "js": [
        "src/i18n.js",
        "src/shell.js",
        "src/store.js",
        "src/engine.js",
        "src/grid.js",
        "src/overlay.js",
        "src/runner.js",
        "src/native.js",
        "src/matching.js",
        "src/pick.js",
        "src/ui.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
